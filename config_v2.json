    "tips": [
      {
        "id": "title_author",
        "icon": "book",
        "title": "Title + author's last name",
        "body": "Drop subtitles, editions and words like \"pdf\" or \"free\". Fewer words find more.",
        "example": "pride and prejudice austen"
      },
      {
        "id": "author",
        "icon": "user",
        "title": "All books by an author",
        "body": "Type the name, then pick Author above the keyboard.",
        "example": "agatha christie",
        "mode": "author"
      },
      {
        "id": "isbn",
        "icon": "scan",
        "title": "Exact edition: the ISBN",
        "body": "13 digits, no dashes. Or scan the barcode.",
        "example": "9780141439518",
        "mode": "isbn"
      },
      {
        "id": "audiobooks",
        "icon": "headphones",
        "title": "Audiobooks",
        "body": "Type just the title, then pick Audiobooks in the results. No need to add \"audiobook\".",
        "example": "the hobbit",
        "media": "audio"
      },
      {
        "id": "magazines",
        "icon": "magazine",
        "title": "Magazines",
        "body": "Name + month or year. Every word has to match, so keep it short. Add -word to leave an edition out.",
        "example": "national geographic 2026",
        "media": "magazine"
      }
